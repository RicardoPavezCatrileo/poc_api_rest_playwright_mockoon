# Copie este archivo como .env para cambiar los valores por defecto.
API_BASE_URL=http://localhost:3001
API_TIMEOUT_MS=20000
# Debe ser menor que SLOW_ENDPOINT_DELAY_MS.
API_SHORT_TIMEOUT_MS=5000
# Debe coincidir con "latency" y "retardo_ms" de /api/usuarios/lento en mocks/usuarios-api.json.
SLOW_ENDPOINT_DELAY_MS=15000
MAX_RESPONSE_TIME_MS=2000
